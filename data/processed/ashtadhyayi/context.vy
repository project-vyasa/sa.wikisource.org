`title [अष्टाध्यायी]

`alias-def { name="s" target="sutra" }

`command-def { name="sutra" category="structure" urn="true" propagate_state="false" }
`command-def { name="mula" category="content" }
`command-def { name="vyakhya" category="content" }
`command-def { name="udaharana" category="content" }

`command-def { name="annotate" category="metadata" flexible_args="true" }

`set context {
  work = "Aṣṭādhyāyī",
  corpus = "ashtadhyayi"
}
