`title [गोपथब्राह्मणम्]

`alias-def { name="p" target="pada" }

`command-def { name="pada" category="structure" urn="true" propagate_state="false" }
`command-def { name="prose" category="content" }

`command-def { name="annotate" category="metadata" flexible_args="true" }

`set context {
  work = "Gopatha Brāhmaṇa",
  corpus = "gopatha-brahmana"
}
