# Local catalog server for the sa_wikisource publisher.
# Run from repo root: caddy run --config sa_wikisource/Caddyfile

:9100 {
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "*"
	}

	handle /registry.json {
		root * /Users/anand/Projects/project-vyasa/sa.wikisource.org/sa_wikisource
		rewrite * /local-registry.json
		file_server
	}

	handle_path /sa_wikisource/* {
		root * /Users/anand/Projects/project-vyasa/sa.wikisource.org/sa_wikisource/dist
		file_server
	}
}
