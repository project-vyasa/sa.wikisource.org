node_modules/
.env
.DS_Store
dist/
sa_wikisource/dist/
build/

# Downloaded HTML cache (idempotent; avoid re-crawling Wikimedia)
data/raw/

# Intermediate extracted structured data
data/extracted/

# Processed Vyasa workspace content (regenerated by transform)
data/processed/*/content/

# VMLT anukramani enrich outputs (regenerated by enrich:rv)
data/processed/*/annotations/
data/processed/*/vocabulary/entities.vy
data/processed/*/vocabulary/meters.vy

# Local pack artifacts (committed configs/templates stay)
data/processed/*/build/
data/processed/*/logs/
